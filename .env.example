# Copy to .env for local use. Never commit real values.
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
DATABASE_URL=

# Primary provider: DeepSeek Search and DeepSeek-V4-Pro generation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional Runpod vLLM fallback. It is called only when DeepSeek text generation fails.
# Leave RUNPOD_API_KEY blank to keep the fallback disabled.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=446e2rl998rklk
RUNPOD_MODEL=Qwen/Qwen3-0.6B
RUNPOD_TIMEOUT_MS=180000

# Per-account AI workspace limit and per-network live-report limit.
AI_REQUESTS_PER_HOUR=10
RATE_LIMIT_PER_HOUR=6
