# Copy to .env for local use. Never commit real values.
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
DATABASE_URL=

# DeepSeek powers live market research, report writing, and the authenticated AI workspace.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Per-account AI workspace limit and per-network live-report limit.
AI_REQUESTS_PER_HOUR=10
RATE_LIMIT_PER_HOUR=6
