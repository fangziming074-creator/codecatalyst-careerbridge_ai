# Copy to .env for local use. Never commit real values.
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
DATABASE_URL=

# "deepseek" keeps the original report generation, "runpod" switches the writer.
# In BOTH modes live market reports still need DeepSeek search.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Deploy a vLLM text-generation endpoint in your own Runpod account.
# RUNPOD_MODEL must match the endpoint's served model name.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=446e2rl998rklk
RUNPOD_MODEL=Qwen/Qwen3-0.6B
RUNPOD_TIMEOUT_MS=120000
AI_REQUESTS_PER_HOUR=10
RATE_LIMIT_PER_HOUR=6
